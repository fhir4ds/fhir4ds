library Comparisons version '1.0.0'

define "Equality": 'ABC' = 'ABC'
// TODO: "Equivalence" must be true using ~ (case-insensitive)
define "Absolute Value": Abs(-5)
// TODO: "Square Root" must return 4
// TODO: "Power" must compute 2 to the 3rd power
define "Age Category": if 25 >= 18 then 'Adult' else 'Minor'
// TODO: "Grade Category" must grade 85 as 'B' using case/when/then/else/end
define "Date Difference": difference in days between @2023-01-01 and @2023-01-31
// TODO: "Date Range" must be true: extract the year from @2024-06-15 and compare to 2024
define "Precedence Test": 2 + 3 * 4
// TODO: "Forced Precedence" must add first, then multiply (use parentheses)
