SELECT fhirpath('{"resourceType":"Patient","s":"Abc abc","pattern":"abc","sub":"X","regex":"[a-z]+"}', 's.replace(pattern, sub)')[1],
       fhirpath_text('{"resourceType":"Patient","s":"Abc abc","pattern":"abc","sub":"X","regex":"[a-z]+"}', 's.matches(regex)'),
       fhirpath('{"resourceType":"Patient","s":"Abc abc","pattern":"abc","sub":"X","regex":"[a-z]+"}', 's.replaceMatches(regex, sub)')[1];
