----
["p1",null,{"given":["Ann"],"family":null}]

query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p1","active":null,"name":[{"given":["Ann"],"family":null}]}', 'descendants().count()');
----
4

# FP-12 EXPLORER regression: descendants() is shorthand for repeat(children())
query I
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p1","a":"x","b":"x","nested":{"c":"x"},"items":[{"v":"x"},{"v":"x"}]}', 'descendants().count() = repeat(children()).count()');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","a":{"x":1,"y":2},"b":{"y":2,"x":1}}', 'descendants().count() = repeat(children()).count()');
----
true

# FP-13 HISTORIAN regression: multi-item Date/Time equality uses singleton temporal semantics
query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '(@2012 | @2013) = (@2012 | @2014)');
----
false

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '(@2012 | @2013) != (@2012 | @2014)');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '(@2017-11-05T01:30:00.0-04:00 | @2012) = (@2017-11-05T00:30:00.0-05:00 | @2012)');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '(@2012-01-01T10:30:31.0 | @2012) = (@2012-01-01T10:30:31 | @2012)');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '(@2012 | @2013) = (@2012-01 | @2013)');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '(@2012 | @2013) != (@2012-01 | @2013)');
----
NULL

# FP-13 EXPLORER regression: Date and partial DateTime are different primitive types
query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '@2012 = @2012T');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '@2012 != @2012T');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '@2012 ~ @2012T');
----
false

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '@2012 !~ @2012T');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '(@2012 | @2013) = (@2012T | @2013T)');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '(@2012 | @2013) ~ (@2012T | @2013T)');
----
false

# FP-13 HISTORIAN regression: complex equivalence recurses through child equivalence
query I
SELECT fhirpath_bool('{"resourceType":"Patient","objA":{"given":["Alpha\tBeta"],"family":"SMITH"},"objB":{"family":"smith","given":["alpha beta"]}}', 'objA ~ objB');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","objA":{"given":["Alpha\tBeta"],"family":"SMITH"},"objB":{"family":"smith","given":["alpha beta"]}}', 'objA !~ objB');
----
false

query I
SELECT fhirpath_bool('{"resourceType":"Patient","objA":{"coding":[{"code":"A"},{"code":"B"}]},"objB":{"coding":[{"code":"b"},{"code":"a"}]}}', 'objA ~ objB');
----
true

# FP-13 SKEPTIC fresh rerun: string equivalence normalizes case and
# individual whitespace code points without trimming or collapsing runs.
query IIIIIII
SELECT fhirpath_bool('{"resourceType":"Observation","nbspLeft":"alpha\u00a0beta","spaceRight":"ALPHA beta"}', '''a  b'' ~ ''a b'''),
       fhirpath_bool('{"resourceType":"Observation","nbspLeft":"alpha\u00a0beta","spaceRight":"ALPHA beta"}', '''a  b'' !~ ''a b'''),
       fhirpath_bool('{"resourceType":"Observation","nbspLeft":"alpha\u00a0beta","spaceRight":"ALPHA beta"}', ''' a'' ~ ''a'''),
       fhirpath_bool('{"resourceType":"Observation","nbspLeft":"alpha\u00a0beta","spaceRight":"ALPHA beta"}', ''' a'' !~ ''a'''),
       fhirpath_bool('{"resourceType":"Observation","nbspLeft":"alpha\u00a0beta","spaceRight":"ALPHA beta"}', '''a\tb'' ~ ''A b'''),
       fhirpath_bool('{"resourceType":"Observation","nbspLeft":"alpha\u00a0beta","spaceRight":"ALPHA beta"}', 'nbspLeft ~ spaceRight'),
       fhirpath_bool('{"resourceType":"Observation","nbspLeft":"alpha\u00a0beta","spaceRight":"ALPHA beta"}', '''É'' ~ ''é''');
----
false	true	false	true	true	true	true

# FP-13 SKEPTIC fresh rerun: multi-item resource Quantity equivalence uses unit semantics
query I
SELECT fhirpath_bool('{"resourceType":"Observation","component":[{"valueQuantity":{"value":1,"unit":"cm","code":"cm"}},{"valueQuantity":{"value":2,"unit":"cm","code":"cm"}}],"referenceRange":[{"high":{"value":0.02,"unit":"m","code":"m"}},{"high":{"value":10,"unit":"mm","code":"mm"}}]}', 'component.value ~ referenceRange.high');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Observation","component":[{"valueQuantity":{"value":1,"unit":"cm","code":"cm"}},{"valueQuantity":{"value":2,"unit":"cm","code":"cm"}}],"referenceRange":[{"high":{"value":0.02,"unit":"m","code":"m"}},{"high":{"value":10,"unit":"mm","code":"mm"}}]}', 'component.value !~ referenceRange.high');
----
false

query IIIIIII
SELECT fhirpath_bool('{"resourceType":"Observation","valueQuantity":{"value":185,"unit":"lbs","code":"[lb_av]","system":"http://unitsofmeasure.org"}}', 'Observation.value = 185 ''[lb_av]'''),
       fhirpath_bool('{"resourceType":"Observation","valueQuantity":{"value":185,"unit":"lbs","code":"[lb_av]","system":"http://unitsofmeasure.org"}}', 'Observation.value != 185 ''kg'''),
       fhirpath_bool('{"resourceType":"Observation","valueQuantity":{"value":185,"unit":"lbs","code":"[lb_av]","system":"http://unitsofmeasure.org"}}', 'Observation.value ~ 185 ''[lb_av]'''),
       fhirpath_bool('{"resourceType":"Observation","valueQuantity":{"value":185,"unit":"lbs","code":"[lb_av]","system":"http://unitsofmeasure.org"}}', 'Observation.value ~ 83.9 ''kg'''),
       fhirpath_bool('{"resourceType":"Observation","valueQuantity":{"value":185,"unit":"lbs","code":"[lb_av]","system":"http://unitsofmeasure.org"}}', 'Observation.value !~ 83.9 ''kg'''),
       fhirpath_bool('{"resourceType":"Observation","valueQuantity":{"value":185,"unit":"lbs","code":"[lb_av]","system":"http://unitsofmeasure.org"}}', 'Observation.value ~ 185 ''kg'''),
       fhirpath_bool('{"resourceType":"Observation","valueQuantity":{"value":185,"unit":"lbs","code":"[lb_av]","system":"http://unitsofmeasure.org"}}', 'Observation.value !~ 185 ''kg''');
----
true	true	true	true	false	false	true

