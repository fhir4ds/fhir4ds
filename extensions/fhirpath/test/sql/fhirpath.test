SELECT fhirpath_json('{"resourceType":"Patient"}', '(-7).combine(3)');
----
[-7,3]

query I
SELECT fhirpath_is_valid('-7.combine(3)') OR fhirpath_is_valid('+7.combine(3)');
----
false

