----
false

query I
SELECT fhirpath('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"Patient","id":"p1"}},{"resource":{"resourceType":"Observation","id":"o1","valueInteger":7}}]}', 'entry.where(true, false).resource.id');
----
[]

query I
SELECT fhirpath('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"Patient","id":"p1"}},{"resource":{"resourceType":"Observation","id":"o1","valueInteger":7}}]}', 'entry.resource.ofType(Observation).value.ofType(Integer)');
