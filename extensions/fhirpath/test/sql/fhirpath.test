# FP-12 SKEPTIC regression: Section 5.8/5.9 tree navigation and utility
# functions must enforce exact signatures, and trace requires a String name.
query I
SELECT fhirpath_is_valid('children(1)') OR fhirpath_is_valid('descendants(1)') OR fhirpath_is_valid('trace()') OR fhirpath_is_valid('trace(1)') OR fhirpath_is_valid('trace(''x'', id, id)') OR fhirpath_is_valid('now(1)') OR fhirpath_is_valid('today(1)') OR fhirpath_is_valid('timeOfDay(1)');
----
false

query I
SELECT fhirpath('{"resourceType":"Patient","id":"p1","name":[{"given":["Ann"]}]}', 'children(1)');
----
[]

query I
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p1","name":[{"given":["Ann"]}]}', 'name.trace(''names'', given).given.count() = 1');
----
true

query I
SELECT fhirpath('{"resourceType":"Patient","id":"p1","name":[{"given":["Ann","A"]}]}', 'name.trace(''names'', given.single()).given.count() = 2');
----
[]

query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p1","name":[{"given":["Ann","A"]}]}', 'name.trace(id).given.count()');
----
2

query I
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p1","name":[{"given":["Ann"],"family":"Able"},{"given":["Bob"],"family":"Baker"}]}', 'name.trace(''names'', given.single()).given.count() = 2');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p1","name":[{"given":["Ann"],"family":"Able"},{"given":["Bob"],"family":"Baker"}]}', 'name.trace(''idx'', $index.single()).given.count() = 2');
----
true

query II
SELECT fhirpath_text('{"resourceType":"Patient","id":"p1","birthDate":"1970-01-01","_birthDate":{"extension":[{"url":"http://example.org/ext/birth","valueString":"midday"}]},"name":[{"given":["Ann"],"family":null}]}', 'descendants().count()'),
       fhirpath_text('{"resourceType":"Patient","id":"p1","birthDate":"1970-01-01","_birthDate":{"extension":[{"url":"http://example.org/ext/birth","valueString":"midday"}]},"name":[{"given":["Ann"],"family":null}]}', 'descendants().where($this = ''midday'').count()');
----
8	1

# FP-12 EXPLORER regression: primitive sibling metadata participates in
# children()/descendants() from the primitive element.
query II
SELECT fhirpath_text('{"resourceType":"Patient","birthDate":"1970-01-01","_birthDate":{"extension":[{"url":"http://example.org/ext/birth","valueString":"midday"}]}}', 'birthDate.children().where(url = ''http://example.org/ext/birth'').valueString'),
       fhirpath_text('{"resourceType":"Patient","name":[{"given":["Ann"],"_given":[{"extension":[{"url":"http://example.org/ext/given","valueString":"alias"}]}]}]}', 'name.given.children().where(url = ''http://example.org/ext/given'').valueString');
----
midday	alias

query I
SELECT fhirpath_text('{"resourceType":"Patient","name":[{"given":["Ann"],"_given":[{"extension":[{"url":"http://example.org/ext/given","valueString":"alias"}]}]}]}', 'name.given.extension(''http://example.org/ext/given'').valueString');
----
alias

# FP-13 EXPLORER regression: complex equality/equivalence must recurse
# through Decimal and Quantity-valued child properties using §6.1 semantics.
query III
SELECT fhirpath_bool('{"resourceType":"Observation","decObjA":{"value":1.24},"decObjB":{"value":1.2},"rangeA":{"high":{"value":1,"unit":"cm","code":"cm","system":"http://unitsofmeasure.org"}},"rangeB":{"high":{"value":10,"unit":"mm","code":"mm","system":"http://unitsofmeasure.org"}}}', 'decObjA ~ decObjB'),
       fhirpath_bool('{"resourceType":"Observation","decObjA":{"value":1.24},"decObjB":{"value":1.2},"rangeA":{"high":{"value":1,"unit":"cm","code":"cm","system":"http://unitsofmeasure.org"}},"rangeB":{"high":{"value":10,"unit":"mm","code":"mm","system":"http://unitsofmeasure.org"}}}', 'rangeA = rangeB'),
       fhirpath_bool('{"resourceType":"Observation","decObjA":{"value":1.24},"decObjB":{"value":1.2},"rangeA":{"high":{"value":1,"unit":"cm","code":"cm","system":"http://unitsofmeasure.org"}},"rangeB":{"high":{"value":10,"unit":"mm","code":"mm","system":"http://unitsofmeasure.org"}}}', 'rangeA ~ rangeB');
----
true	true	true

query II
SELECT fhirpath_bool('{"resourceType":"Observation","rangeA":{"high":{"value":1,"unit":"cm","code":"cm","system":"http://unitsofmeasure.org"}},"rangeBad":{"high":{"value":1,"unit":"g","code":"g","system":"http://unitsofmeasure.org"}}}', 'rangeA = rangeBad'),
       fhirpath_bool('{"resourceType":"Observation","rangeA":{"high":{"value":1,"unit":"cm","code":"cm","system":"http://unitsofmeasure.org"}},"rangeBad":{"high":{"value":1,"unit":"g","code":"g","system":"http://unitsofmeasure.org"}}}', 'rangeA ~ rangeBad');
----
NULL	NULL

# FP-14 SKEPTIC regression: Section 6.2 comparison excludes Boolean
# operands and requires singleton operands.
query II
SELECT fhirpath_bool('{"resourceType":"Observation","truth":true,"falsity":false}', 'true > false'),
       fhirpath_bool('{"resourceType":"Observation","truth":true,"falsity":false}', 'truth > falsity');
----
NULL	NULL

query I
SELECT fhirpath_is_valid('true > false') OR fhirpath_is_valid('(1 | 2) < 3') OR fhirpath_is_valid('1 < (2 | 3)');
----
false

# FP-14 SKEPTIC regression: calendar duration keywords and UCUM duration
# codes above seconds are incomparable for Section 6.2 ordering.
query IIIIIII
SELECT fhirpath_bool('{"resourceType":"Observation"}', '1 year > 1 ''a'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 month <= 1 ''mo'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 week > 1 ''wk'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 day > 1 ''d'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 hour > 1 ''h'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 minute > 1 ''min'''),
       fhirpath_bool('{"resourceType":"Observation"}', '10 seconds > 1 ''s''');
----
NULL	NULL	NULL	NULL	NULL	NULL	true

# FP-14 SKEPTIC fresh regression: Section 6.2 numeric and same-unit
# Quantity ordering must preserve exact authored/JSON number text above
# binary64 precision.
query IIIIII
SELECT fhirpath_bool('{"resourceType":"Observation","bigA":9007199254740992,"bigB":9007199254740993,"valueQuantity":{"value":9007199254740992,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"},"component":[{"valueQuantity":{"value":9007199254740993,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"}}]}', '9223372036854775806L < 9223372036854775807L'),
       fhirpath_bool('{"resourceType":"Observation","bigA":9007199254740992,"bigB":9007199254740993,"valueQuantity":{"value":9007199254740992,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"},"component":[{"valueQuantity":{"value":9007199254740993,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"}}]}', '9223372036854775807L <= 9223372036854775806L'),
       fhirpath_bool('{"resourceType":"Observation","bigA":9007199254740992,"bigB":9007199254740993,"valueQuantity":{"value":9007199254740992,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"},"component":[{"valueQuantity":{"value":9007199254740993,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"}}]}', '9007199254740992.0 < 9007199254740993.0'),
       fhirpath_bool('{"resourceType":"Observation","bigA":9007199254740992,"bigB":9007199254740993,"valueQuantity":{"value":9007199254740992,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"},"component":[{"valueQuantity":{"value":9007199254740993,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"}}]}', 'bigA < bigB'),
       fhirpath_bool('{"resourceType":"Observation","bigA":9007199254740992,"bigB":9007199254740993,"valueQuantity":{"value":9007199254740992,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"},"component":[{"valueQuantity":{"value":9007199254740993,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"}}]}', '9007199254740992 ''mg'' < 9007199254740993 ''mg'''),
       fhirpath_bool('{"resourceType":"Observation","bigA":9007199254740992,"bigB":9007199254740993,"valueQuantity":{"value":9007199254740992,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"},"component":[{"valueQuantity":{"value":9007199254740993,"unit":"mg","code":"mg","system":"http://unitsofmeasure.org"}}]}', 'valueQuantity < component.valueQuantity');
----
true	false	true	true	true	true

# FP-15 SKEPTIC regression: System.Any is the root type for Section 6.3
# is/as, and unqualified capitalized choice primitive assertions remain valid.
query IIIIIIII
SELECT fhirpath_bool('{"resourceType":"Patient","id":"pat-1","active":true,"name":[{"family":"Smith"}]}', '1 is System.Any'),
       fhirpath_bool('{"resourceType":"Patient","id":"pat-1","active":true,"name":[{"family":"Smith"}]}', '1.as(System.Any).exists()'),
       fhirpath_bool('{"resourceType":"Patient","id":"pat-1","active":true,"name":[{"family":"Smith"}]}', 'Patient is System.Any'),
       fhirpath_bool('{"resourceType":"Patient","id":"pat-1","active":true,"name":[{"family":"Smith"}]}', 'Patient.as(System.Any).exists()'),
       fhirpath_bool('{"resourceType":"Patient","id":"pat-1","active":true,"name":[{"family":"Smith"}]}', 'active is System.Any'),
       fhirpath_bool('{"resourceType":"Patient","id":"pat-1","active":true,"name":[{"family":"Smith"}]}', 'name.first().as(System.Any).exists()'),
       fhirpath_bool('{"resourceType":"Observation","valueInteger":5}', 'value.as(Integer).exists()'),
       fhirpath_bool('{"resourceType":"Observation","valueInteger":5}', 'value.as(System.Integer).exists()');
----
true	true	true	true	true	true	true	false

# FP-19 SKEPTIC regression: Section 7 aggregate init expressions use the
# outer focus, and Section 8 lexical rules keep div/mod reserved plus
# whitespace limited to space/tab/LF/CR.
query IIIIIIIIII
SELECT fhirpath_text('{"resourceType":"Patient","seed":10,"a":[1,2,3]}', 'a.aggregate($total + $this, seed)'),
       fhirpath_text('{"resourceType":"Patient","seed":10,"a":[1,2,3]}', '{}.aggregate($this + $total, seed)'),
       fhirpath_is_valid('div'),
       fhirpath_is_valid('mod'),
       fhirpath_is_valid('1' || chr(12) || '+' || chr(12) || '2'),
       fhirpath_is_valid('1' || chr(11) || '+' || chr(11) || '2'),
       fhirpath_is_valid('a.aggregate()'),
       fhirpath_is_valid('a.aggregate($this, 0, 1)'),
       fhirpath_is_valid('aggregate()'),
       fhirpath_is_valid('aggregate($this, {}, {})');
----
16	10	false	false	false	false	false	false	false	false

# FP-03 SKEPTIC regression: Section 5.1 subsetOf()/supersetOf() arguments
# inside scoped functions are evaluated relative to the scoped item, not root.
query IIIII
SELECT fhirpath_json('{"resourceType":"Patient","groups":[{"left":[1,2],"right":[1,2,3]},{"left":[1,4],"right":[1,2,3]}]}', 'groups.select(left.subsetOf(right))'),
       fhirpath_bool('{"resourceType":"Patient","groups":[{"left":[1,2],"right":[1,2,3]},{"left":[1,4],"right":[1,2,3]}]}', 'groups.exists(left.subsetOf(right))'),
       fhirpath_bool('{"resourceType":"Patient","groups":[{"left":[1,2],"right":[1,2,3]},{"left":[1,4],"right":[1,2,3]}]}', 'groups.all(right.supersetOf(left))'),
       fhirpath_bool('{"resourceType":"Patient","groups":[{"left":[1,2],"right":[1,2,3]},{"left":[1,4],"right":[1,2,3]}]}', 'groups.exists(right.supersetOf(left).not())'),
       fhirpath_json('{"resourceType":"Patient","groups":[{"left":[1,2],"right":[1,2,3]},{"left":[1,4],"right":[1,2,3]}]}', 'groups.select(right.supersetOf(left))');
----
[true,false]	true	false	true	[true,false]

# FP-20 SKEPTIC regression: Section 10 reflection type() has no arguments.
query IIIIIIII
SELECT fhirpath_text('{"resourceType":"Patient","id":"p1"}', 'type(false)'),
       fhirpath_json('{"resourceType":"Patient","id":"p1"}', 'type(false)'),
       fhirpath_is_valid('type(false)'),
       fhirpath_is_valid('type(false, true)'),
       fhirpath_text('{"resourceType":"Patient","id":"p1"}', '1.type(false)'),
       fhirpath_json('{"resourceType":"Patient","id":"p1"}', '1.type(false)'),
       fhirpath_is_valid('1.type(false)'),
       fhirpath_is_valid('1.type(false, true)');
----
NULL	NULL	false	false	NULL	NULL	false	false

# FP-20 SKEPTIC regression: Section 9 defineVariable() must receive a
# singleton String name and only one optional value expression.
query IIIIIIIIII
SELECT fhirpath_text('{"resourceType":"Patient","id":"p1","active":true}', 'defineVariable()'),
       fhirpath_is_valid('defineVariable()'),
       fhirpath_text('{"resourceType":"Patient","id":"p1","active":true}', 'defineVariable(1)'),
       fhirpath_is_valid('defineVariable(1)'),
       fhirpath_text('{"resourceType":"Patient","id":"p1","active":true}', 'defineVariable(true, id)'),
       fhirpath_is_valid('defineVariable(true, id)'),
       fhirpath_text('{"resourceType":"Patient","id":"p1","active":true}', 'defineVariable({}, id)'),
       fhirpath_is_valid('defineVariable({}, id)'),
       fhirpath_text('{"resourceType":"Patient","id":"p1","active":true}', 'defineVariable(''x'', id, active)'),
       fhirpath_is_valid('defineVariable(''x'', id, active)');
----
NULL	false	NULL	false	NULL	false	NULL	false	NULL	false

# FP-20 HISTORIAN regression: formal grammar hides whitespace/comments between
# '%' and the external constant identifier/string.
query IIIIIIIIII
SELECT fhirpath_text('{"resourceType":"Patient","id":"p1"}', '% ''ucum'''),
       fhirpath_is_valid('% ''ucum'''),
       fhirpath_text('{"resourceType":"Patient","id":"p1"}', '%/*grammar*/''ucum'''),
       fhirpath_is_valid('%/*grammar*/''ucum'''),
       fhirpath_text('{"resourceType":"Patient","id":"p1"}', '%//grammar
''ucum'''),
       fhirpath_is_valid('%//grammar
''ucum'''),
       fhirpath_text('{"resourceType":"Patient","id":"p1"}', '%
`context`.id'),
       fhirpath_is_valid('%
`context`.id'),
       fhirpath_text('{"resourceType":"Patient","id":"p1"}', '% ''unknown'''),
       fhirpath_is_valid('% ''unknown''');
----
http://unitsofmeasure.org	true	http://unitsofmeasure.org	true	http://unitsofmeasure.org	true	p1	true	NULL	false

# FP-20 EXPLORER regression: Section 10 reflection must use FHIR model
# primitive metadata for resource-specific code fields, including
# Questionnaire.subjectType.
query III
SELECT fhirpath_text('{"resourceType":"Questionnaire","subjectType":["Patient"]}', 'Questionnaire.subjectType.type().name'),
       fhirpath_bool('{"resourceType":"Questionnaire","subjectType":["Patient"]}', 'Questionnaire.subjectType.is(code)'),
       fhirpath_bool('{"resourceType":"Questionnaire","subjectType":["Patient"]}', 'Questionnaire.subjectType.is(string)');
----
code	true	true

# FP-04 EXPLORER regression: ofType() must include R4 resource subclasses
# when filtering by Resource or DomainResource supertypes.
query III
SELECT fhirpath_json('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"Patient","id":"pat"}},{"resource":{"resourceType":"Observation","id":"obs"}},{"resource":{"resourceType":"Questionnaire","id":"que"}},{"resource":{"resourceType":"QuestionnaireResponse","id":"qr"}},{"resource":{"resourceType":"ValueSet","id":"vs"}},{"resource":{"resourceType":"CodeSystem","id":"cs"}},{"resource":{"resourceType":"Binary","id":"bin"}},{"resource":{"resourceType":"Parameters","id":"par"}}]}', 'entry.resource.ofType(Resource).id'),
       fhirpath_json('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"Patient","id":"pat"}},{"resource":{"resourceType":"Observation","id":"obs"}},{"resource":{"resourceType":"Questionnaire","id":"que"}},{"resource":{"resourceType":"QuestionnaireResponse","id":"qr"}},{"resource":{"resourceType":"ValueSet","id":"vs"}},{"resource":{"resourceType":"CodeSystem","id":"cs"}},{"resource":{"resourceType":"Binary","id":"bin"}},{"resource":{"resourceType":"Parameters","id":"par"}}]}', 'entry.resource.ofType(DomainResource).id'),
       fhirpath_json('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"Patient","id":"pat"}},{"resource":{"resourceType":"Observation","id":"obs"}},{"resource":{"resourceType":"Questionnaire","id":"que"}},{"resource":{"resourceType":"QuestionnaireResponse","id":"qr"}},{"resource":{"resourceType":"ValueSet","id":"vs"}},{"resource":{"resourceType":"CodeSystem","id":"cs"}},{"resource":{"resourceType":"Binary","id":"bin"}},{"resource":{"resourceType":"Parameters","id":"par"}}]}', 'entry.resource.ofType(Questionnaire).id');
----
["pat","obs","que","qr","vs","cs","bin","par"]	["pat","obs","que","qr","vs","cs"]	["que"]
