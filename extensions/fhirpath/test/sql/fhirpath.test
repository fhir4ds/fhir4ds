[7]

# FP-15 SKEPTIC regression: valid R4 resource type specifiers must use the
# same model knowledge as native subtype checks.
query IIIII
SELECT fhirpath_text('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"CodeSystem","id":"cs","status":"active","content":"complete"}},{"resource":{"resourceType":"QuestionnaireResponse","id":"qr","status":"completed"}},{"resource":{"resourceType":"Binary","id":"bin","contentType":"text/plain"}},{"resource":{"resourceType":"Parameters","id":"params","parameter":[{"name":"n","valueInteger":7}]}}]}', 'entry.resource.ofType(CodeSystem).id'),
       fhirpath_text('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"CodeSystem","id":"cs","status":"active","content":"complete"}},{"resource":{"resourceType":"QuestionnaireResponse","id":"qr","status":"completed"}},{"resource":{"resourceType":"Binary","id":"bin","contentType":"text/plain"}},{"resource":{"resourceType":"Parameters","id":"params","parameter":[{"name":"n","valueInteger":7}]}}]}', 'entry.resource.ofType(QuestionnaireResponse).id'),
       fhirpath_text('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"CodeSystem","id":"cs","status":"active","content":"complete"}},{"resource":{"resourceType":"QuestionnaireResponse","id":"qr","status":"completed"}},{"resource":{"resourceType":"Binary","id":"bin","contentType":"text/plain"}},{"resource":{"resourceType":"Parameters","id":"params","parameter":[{"name":"n","valueInteger":7}]}}]}', 'entry.resource.ofType(Binary).id'),
       fhirpath_text('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"CodeSystem","id":"cs","status":"active","content":"complete"}},{"resource":{"resourceType":"QuestionnaireResponse","id":"qr","status":"completed"}},{"resource":{"resourceType":"Binary","id":"bin","contentType":"text/plain"}},{"resource":{"resourceType":"Parameters","id":"params","parameter":[{"name":"n","valueInteger":7}]}}]}', 'entry.resource.ofType(Parameters).id'),
       fhirpath_bool('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"CodeSystem","id":"cs","status":"active","content":"complete"}},{"resource":{"resourceType":"QuestionnaireResponse","id":"qr","status":"completed"}},{"resource":{"resourceType":"Binary","id":"bin","contentType":"text/plain"}},{"resource":{"resourceType":"Parameters","id":"params","parameter":[{"name":"n","valueInteger":7}]}}]}', 'entry.resource.ofType(Binary).single() is Resource');
----
cs	qr	bin	params	true

query I
SELECT fhirpath_text('{"resourceType":"Bundle","entry":[{"resource":{"resourceType":"Observation","id":"obs","valueInteger":5}}]}', 'entry.resource.ofType(Observation).value.as(Integer)');
----
5

# FP-15 HISTORIAN regression: Section 6.3 is returns false for empty input,
# while as keeps returning empty for empty input.
