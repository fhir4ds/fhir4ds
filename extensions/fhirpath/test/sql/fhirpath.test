       fhirpath_bool('{"resourceType":"Patient"}', 'missing.is(Integer)'),
       fhirpath('{"resourceType":"Patient"}', 'missing as Integer'),
       fhirpath('{"resourceType":"Patient"}', 'missing.as(Integer)');
