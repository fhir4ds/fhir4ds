SELECT fhirpath_is_valid('a.skip()') OR fhirpath_is_valid('a.take()') OR fhirpath_is_valid('a.skip(1, 2)') OR fhirpath_is_valid('a.take(1, 2)') OR fhirpath_is_valid('a.skip(1.0)') OR fhirpath_is_valid('a.take(1.0)');
