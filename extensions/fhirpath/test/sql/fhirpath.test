SELECT fhirpath_is_valid('s.upper(1)') OR fhirpath_is_valid('s.lower(1)') OR fhirpath_is_valid('s.trim(1)') OR fhirpath_is_valid('s.trim({})') OR fhirpath_is_valid('s.replace(''a'')') OR fhirpath_is_valid('s.replace(''a'', ''b'', ''c'')') OR fhirpath_is_valid('s.matches()') OR fhirpath_is_valid('s.matches(''a'', ''b'')') OR fhirpath_is_valid('s.replaceMatches(''a'')') OR fhirpath_is_valid('s.replaceMatches(''a'', ''b'', ''c'')') OR fhirpath_is_valid('s.length(1)') OR fhirpath_is_valid('s.toChars(1)');
----
false

query I
SELECT fhirpath_is_valid('s.replace(123, ''x'')') OR fhirpath_is_valid('s.matches(''(a+)+'')') OR fhirpath_is_valid('s.matches(''[invalid'')') OR fhirpath_is_valid('s.replaceMatches(''(a|aa)+'', ''x'')') OR fhirpath_is_valid('s.replaceMatches(''[invalid'', ''x'')') OR fhirpath_is_valid('s.matches(''' || repeat('a', 1001) || ''')') OR fhirpath_is_valid('s.replaceMatches(''' || repeat('a', 1001) || ''', ''x'')') OR fhirpath_is_valid('123.upper()') OR fhirpath_is_valid('123.replace(''2'', ''x'')') OR fhirpath_is_valid('''abc''.matches(''(a+)+'')');
----
false

