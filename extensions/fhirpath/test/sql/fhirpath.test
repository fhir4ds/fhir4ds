# FP-13 HISTORIAN fresh rerun: numeric primitives implicitly compare as Quantity unit '1'
query IIIIIIII
SELECT fhirpath_bool('{"resourceType":"Observation"}', '23 = 23 ''1'''),
       fhirpath_bool('{"resourceType":"Observation"}', '23 != 23 ''1'''),
       fhirpath_bool('{"resourceType":"Observation"}', '23 ~ 23 ''1'''),
       fhirpath_bool('{"resourceType":"Observation"}', '23 !~ 23 ''1'''),
       fhirpath_bool('{"resourceType":"Observation"}', '23 = 24 ''1'''),
       fhirpath_bool('{"resourceType":"Observation"}', '23 != 24 ''1'''),
       fhirpath_bool('{"resourceType":"Observation"}', '23 ~ 23.4 ''1'''),
       fhirpath_bool('{"resourceType":"Observation"}', '23 !~ 23.4 ''1''');
----
true	false	true	false	false	true	true	false

query IIII
SELECT fhirpath_bool('{"resourceType":"Observation","component":[{"valueQuantity":{"value":23,"unit":"1","code":"1"}},{"valueQuantity":{"value":24,"unit":"1","code":"1"}}]}', 'component[0].value = 23'),
       fhirpath_bool('{"resourceType":"Observation","component":[{"valueQuantity":{"value":23,"unit":"1","code":"1"}},{"valueQuantity":{"value":24,"unit":"1","code":"1"}}]}', 'component[0].value ~ 23'),
       fhirpath_bool('{"resourceType":"Observation","component":[{"valueQuantity":{"value":23,"unit":"1","code":"1"}},{"valueQuantity":{"value":24,"unit":"1","code":"1"}}]}', 'component.value = (23 | 24)'),
       fhirpath_bool('{"resourceType":"Observation","component":[{"valueQuantity":{"value":23,"unit":"1","code":"1"}},{"valueQuantity":{"value":24,"unit":"1","code":"1"}}]}', 'component.value ~ (24 | 23)');
----
true	true	true	true

query II
SELECT fhirpath_bool('{"resourceType":"Observation"}', '1 ''cm'' ~ 1 ''s'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 ''cm'' !~ 1 ''s''');
----
NULL	NULL

# FP-13 EXPLORER fresh rerun: JSON numeric equality/equivalence must not lose
# exact Integer/Long-sized values through binary double conversion.
query IIIIIIII
SELECT fhirpath_bool('{"resourceType":"Observation","a":9007199254740992,"b":9007199254740993,"objA":{"value":9007199254740992},"objB":{"value":9007199254740993}}', 'a = b'),
       fhirpath_bool('{"resourceType":"Observation","a":9007199254740992,"b":9007199254740993,"objA":{"value":9007199254740992},"objB":{"value":9007199254740993}}', 'a != b'),
       fhirpath_bool('{"resourceType":"Observation","a":9007199254740992,"b":9007199254740993,"objA":{"value":9007199254740992},"objB":{"value":9007199254740993}}', 'a ~ b'),
       fhirpath_bool('{"resourceType":"Observation","a":9007199254740992,"b":9007199254740993,"objA":{"value":9007199254740992},"objB":{"value":9007199254740993}}', 'a !~ b'),
       fhirpath_bool('{"resourceType":"Observation","a":9007199254740992,"b":9007199254740993,"objA":{"value":9007199254740992},"objB":{"value":9007199254740993}}', 'objA = objB'),
       fhirpath_bool('{"resourceType":"Observation","a":9007199254740992,"b":9007199254740993,"objA":{"value":9007199254740992},"objB":{"value":9007199254740993}}', 'objA != objB'),
       fhirpath_bool('{"resourceType":"Observation","a":9007199254740992,"b":9007199254740993,"objA":{"value":9007199254740992},"objB":{"value":9007199254740993}}', 'objA ~ objB'),
       fhirpath_bool('{"resourceType":"Observation","a":9007199254740992,"b":9007199254740993,"objA":{"value":9007199254740992},"objB":{"value":9007199254740993}}', 'objA !~ objB');
----
false	true	false	true	false	true	false	true

# FP-13 SKEPTIC fresh rerun: equality treats mixed calendar/UCUM year-month
# durations as indeterminate, while definite time-valued durations convert.
query IIII
SELECT fhirpath_bool('{"resourceType":"Observation"}', '1 year = 1 ''a'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 year != 1 ''a'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 month = 1 ''mo'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 month != 1 ''mo''');
----
NULL	NULL	NULL	NULL

query IIIIIIIIII
SELECT fhirpath_bool('{"resourceType":"Observation"}', '1 year ~ 1 ''a'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 year !~ 1 ''a'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 year = 12 months'),
       fhirpath_bool('{"resourceType":"Observation"}', '1 ''a'' = 12 ''mo'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 week = 1 ''wk'''),
       fhirpath_bool('{"resourceType":"Observation"}', '7 days = 1 ''wk'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 day = 1 ''d'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 day != 1 ''d'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 hour = 60 ''min'''),
       fhirpath_bool('{"resourceType":"Observation"}', '1 minute = 60 ''s''');
----
true	false	true	true	true	true	true	false	true	true

query I
SELECT fhirpath_bool('{"resourceType":"Observation"}', '1.25 ~ 1.2');
----
false

