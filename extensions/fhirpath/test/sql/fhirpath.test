SELECT fhirpath_is_valid('a.combine()') OR fhirpath_is_valid('a.union()') OR fhirpath_is_valid('a.intersect()') OR fhirpath_is_valid('a.exclude()') OR fhirpath_is_valid('a.union(b, ints)');
