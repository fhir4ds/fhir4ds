# name: test/sql/fhirpath.test
# description: test fhirpath extension
# group: [sql]

# Before we load the extension, this will fail
statement error
SELECT fhirpath_text('{"id":"1"}', 'id');
----
Catalog Error: Scalar Function with name fhirpath_text does not exist!

# Require statement will ensure this test is run with this extension loaded
require fhirpath

# =====================================================================
# fhirpath_text — basic path access
# =====================================================================
query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"123"}', 'id');
----
123

query I
SELECT fhirpath_text('{"resourceType":"Patient","name":[{"given":["John"]}]}', 'name.given');
----
John

# Test deeply nested path
query I
SELECT fhirpath_text('{"resourceType":"Observation","component":[{"code":{"text":"BP"}}]}', 'component.code.text');
----
BP

# Test resourceType access
query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"1"}', 'resourceType');
----
Patient

# =====================================================================
# fhirpath_number — numeric extraction
# =====================================================================
query I
SELECT fhirpath_number('{"resourceType":"Observation","valueQuantity":{"value":120}}', 'valueQuantity.value');
----
120.0

query I
SELECT fhirpath_number('{"resourceType":"Observation","valueQuantity":{"value":98.6}}', 'valueQuantity.value');
----
98.6

# =====================================================================
# fhirpath_bool — boolean extraction
# =====================================================================
query I
SELECT fhirpath_bool('{"resourceType":"Patient","active":true}', 'active');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","active":false}', 'active');
----
false

query I
SELECT fhirpath_bool('{"resourceType":"Observation","code":{"coding":[{"system":"http://loinc.org","code":"8480-6"}]}}', 'code.coding.where(system = ''http://loinc.org'' and code = ''8480-6'').exists()');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Observation","code":{"coding":[{"system":"http://loinc.org","code":"8480-6"}]}}', 'code.coding.where(system = ''http://loinc.org'' and code = ''8462-4'').exists()');
----
false

query I
SELECT fhirpath_bool('{"resourceType":"Observation","valueCodeableConcept":{"coding":[{"system":"http://snomed.info/sct","code":"12345"}]}}', 'value.coding.where(system = ''http://snomed.info/sct'' and code = ''12345'').exists()');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Condition","clinicalStatus":{"coding":[{"code":"active"}]}}', 'clinicalStatus.coding.where(code = ''recurrence'' or code = ''active'').exists()');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","nested":[{"flags":[true]},{"flags":[false,true]}]}', 'nested.exists(flags)');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation","category":[{"coding":[{"system":"http://terminology.hl7.org/CodeSystem/observation-category","code":"laboratory"}]},{"coding":[{"system":"http://example.org","code":"other"}]}]}', 'Observation.category.coding.where(system = ''http://terminology.hl7.org/CodeSystem/observation-category'' and code = ''laboratory'').exists()');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"MedicationRequest","extension":[{"url":"http://example.org/other","valueCodeableConcept":{"coding":[{"system":"http://snomed.info/sct","code":"999"}]}},{"url":"http://example.org/reason","valueCodeableConcept":{"coding":[{"system":"http://snomed.info/sct","code":"720834000"}]}}]}', 'extension.where(url = ''http://example.org/reason'').value.coding.where(system = ''http://snomed.info/sct'' and code = ''720834000'').exists()');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"MedicationRequest","extension":[{"url":"http://example.org/reason","valueCodeableConcept":{"coding":[{"system":"http://snomed.info/sct","code":"999"}]}}]}', 'extension.where(url = ''http://example.org/reason'').value.coding.where(system = ''http://snomed.info/sct'' and code = ''720834000'').exists()');
----
false

query I
SELECT fhirpath_text('{"resourceType":"Patient","extension":[{"url":"http://example.org/sex","valueCode":"248153007"},{"url":"http://example.org/other","valueCode":"x"}]}', 'extension.where(url = ''http://example.org/sex'').valueCode');
----
248153007

query I
SELECT fhirpath_text('{"resourceType":"Patient","extension":[{"url":"http://example.org/race","extension":[{"url":"ombCategory","valueCoding":{"code":"2106-3"}},{"url":"detailed","valueCoding":{"code":"1586-7"}}]}]}', 'extension.where(url = ''http://example.org/race'').extension.where(url = ''ombCategory'').valueCoding.code');
----
2106-3

query I
SELECT fhirpath_text('{"resourceType":"Patient","extension":[{"url":"http://example.org/race","extension":[{"url":"detailed","valueCoding":{"code":"1586-7"}}]}]}', 'extension.where(url = ''http://example.org/race'').extension.where(url = ''ombCategory'').valueCoding.code');
----
NULL

# =====================================================================
# fhirpath_is_valid — expression validation
# =====================================================================
query I
SELECT fhirpath_is_valid('Patient.name.given');
----
true

query I
SELECT fhirpath_is_valid('invalid!!!');
----
false

query I
SELECT fhirpath_is_valid('name.where(given = ''John'')');
----
true

query I
SELECT fhirpath_is_valid('foo()');
----
false

# =====================================================================
# NULL handling
# =====================================================================
query I
SELECT fhirpath_text(NULL, 'id');
----
NULL

query I
SELECT fhirpath_text('{"id":"1"}', NULL);
----
NULL

query I
SELECT fhirpath_number(NULL, 'value');
----
NULL

query I
SELECT fhirpath_bool(NULL, 'active');
----
NULL

# =====================================================================
# fhirpath — list return
# =====================================================================
query I
SELECT fhirpath('{"resourceType":"Patient","name":[{"given":["John","James"]}]}', 'name.given');
----
[John, James]

query I
SELECT fhirpath('{"resourceType":"Encounter","location":[{"period":{"start":"2026-01-01"}},{"period":{"start":"2026-01-02"}}]}', 'location.period.start');
----
[2026-01-01, 2026-01-02]

query I
SELECT fhirpath('{"resourceType":"Patient","extension":[{"url":"http://example.org/race","extension":[{"url":"ombCategory","valueCoding":{"code":"2106-3"}},{"url":"ombCategory","valueCoding":{"code":"1002-5"}}]}]}', 'extension.where(url = ''http://example.org/race'').extension.where(url = ''ombCategory'').valueCoding.code');
----
[2106-3, 1002-5]

# =====================================================================
# fhirpath_repeat — SQL-on-FHIR repeat traversal
# =====================================================================
query I
SELECT array_length(fhirpath_repeat('{"resourceType":"Questionnaire","item":[{"linkId":"a","item":[{"linkId":"a.1"}]},{"linkId":"b"}]}', '["item"]'));
----
3

query I
SELECT list_extract(fhirpath_repeat('{"resourceType":"Questionnaire","item":[{"linkId":"a","item":[{"linkId":"a.1"}]},{"linkId":"b"}]}', '["item"]'), 2);
----
{"linkId":"a.1"}

# =====================================================================
# fhirpath_date — date normalization
# =====================================================================
query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"1990"}', 'birthDate');
----
1990

query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"1990-06"}', 'birthDate');
----
1990-06

query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"1990-06-15"}', 'birthDate');
----
1990-06-15

# Full datetime should be truncated to date
query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"1990-06-15T10:30:00Z"}', 'birthDate');
----
1990-06-15

# =====================================================================
# Complex expressions — where clauses
# =====================================================================
query I
SELECT fhirpath_text('{"resourceType":"Observation","component":[{"code":{"coding":[{"code":"8480-6"}]},"valueQuantity":{"value":120}},{"code":{"coding":[{"code":"8462-4"}]},"valueQuantity":{"value":80}}]}', 'component.where(code.coding.exists(code = ''8480-6'')).valueQuantity.value');
----
120

# Extension function
query I
SELECT fhirpath_text('{"resourceType":"Patient","extension":[{"url":"http://example.org/race","valueString":"White"},{"url":"http://example.org/ethnicity","valueString":"Hispanic"}]}', 'extension.where(url = ''http://example.org/race'').valueString');
----
White

query I
SELECT fhirpath_text('{"resourceType":"Patient","extension":[{"url":"http://example.org/race","valueString":"White"},{"url":"http://example.org/ethnicity","valueString":"Hispanic"}]}', 'extension.where(url = ''http://example.org/ethnicity'').valueString');
----
Hispanic

# =====================================================================
# String functions
# =====================================================================
query I
SELECT fhirpath_bool('{"resourceType":"Patient","name":[{"given":["John"]}]}', 'name.given.startsWith(''Jo'')');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","name":[{"given":["John"]}]}', 'name.given.endsWith(''hn'')');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","name":[{"given":["John"]}]}', 'name.given.contains(''oh'')');
----
true

query I
SELECT fhirpath_text('{"resourceType":"Patient","s":"abcdef"}', 's.substring(6)');
----
NULL

query I
SELECT fhirpath_text('{"resourceType":"Patient","s":"abc123"}', 's.substring(''1'')');
----
NULL

query I
SELECT fhirpath_text('{"resourceType":"Patient","s":"abc123"}', 's.indexOf(123)');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Patient","s":"abc123"}', 's.contains(123)');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Patient","num":123}', 'num.contains(''2'')');
----
NULL

query I
SELECT fhirpath_is_valid('''abc''.indexOf(''a'', ''b'')');
----
false

query I
SELECT fhirpath_number('{"resourceType":"Patient","s":"abc123"}', 's.indexOf(''a'', ''b'')');
----
NULL

query I
SELECT fhirpath_is_valid('''abc''.substring(1, 2, 3)');
----
false

query I
SELECT fhirpath_text('{"resourceType":"Patient","s":"abc123"}', 's.substring(1, 2, 3)');
----
NULL

query I
SELECT fhirpath_is_valid('''abc''.contains(1)');
----
false

query I
SELECT fhirpath_is_valid('''abc''.substring(''1'')');
----
false

query I
SELECT fhirpath_number('{"resourceType":"Patient","s":"abcdef","term":"cd"}', 's.indexOf(term)');
----
2.0

query I
SELECT fhirpath_text('{"resourceType":"Patient","s":"abcdef","start":2,"length":3}', 's.substring(start, length)');
----
cde

query I
SELECT fhirpath_bool('{"resourceType":"Patient","s":"abcdef","prefix":"ab"}', 's.startsWith(prefix)');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","s":"abcdef","suffix":"ef"}', 's.endsWith(suffix)');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient","s":"abcdef","term":"cd"}', 's.contains(term)');
----
true

query I
SELECT fhirpath_number('{"resourceType":"Patient","s":"abcdef","term":123}', 's.indexOf(term)');
----
NULL

query I
SELECT fhirpath_text('{"resourceType":"Patient","s":"abcdef","lengths":[1,2]}', 's.substring(1, lengths)');
----
NULL

# =====================================================================
# Existence and count functions
# =====================================================================
query I
SELECT fhirpath_bool('{"resourceType":"Patient","name":[{"given":["John"]}]}', 'name.exists()');
----
true

query I
SELECT fhirpath_bool('{"resourceType":"Patient"}', 'name.exists()');
----
false

query I
SELECT fhirpath_number('{"resourceType":"Patient","name":[{"given":["John","James"]}]}', 'name.given.count()');
----
2.0

# =====================================================================
# Malformed JSON handling (should return NULL, not crash)
# =====================================================================
query I
SELECT fhirpath_text('not json', 'id');
----
NULL

query I
SELECT fhirpath_text('', 'id');
----
NULL

# Missing field (should return NULL)
query I
SELECT fhirpath_text('{"resourceType":"Patient"}', 'birthDate');
----
NULL

# =====================================================================
# fhirpath_json — JSON serialization
# =====================================================================
query I
SELECT length(fhirpath_json('{"resourceType":"Patient","id":"123"}', 'id')) > 0;
----
true

# =====================================================================
# fhirpath_timestamp — timestamp pass-through
# =====================================================================
query I
SELECT fhirpath_timestamp('{"resourceType":"Observation","effectiveDateTime":"2024-01-15T10:30:00Z"}', 'effectiveDateTime');
----
2024-01-15T10:30:00Z

# FP-01 HISTORIAN regression: timestamp wrapper only returns DateTime values
query I
SELECT fhirpath_timestamp('{"resourceType":"Patient","id":"p"}', 'true') IS NULL;
----
true

query I
SELECT fhirpath_timestamp('{"resourceType":"Patient","id":"p"}', '@2014') IS NULL;
----
true

query I
SELECT fhirpath_timestamp('{"resourceType":"Patient","id":"p"}', '@2014T');
----
2014T

# FP-01 HISTORIAN regression: quantity wrapper only returns Quantity values
query I
SELECT fhirpath_quantity('{"resourceType":"Patient","id":"p"}', 'true') IS NULL;
----
true

query I
SELECT fhirpath_quantity('{"resourceType":"Patient","id":"p"}', '10 ''mg''');
----
10 'mg'

query I
SELECT fhirpath_quantity('{"resourceType":"Observation","valueQuantity":{"value":5,"unit":"mg","code":"mg"}}', 'valueQuantity');
----
{"value":5,"unit":"mg","code":"mg"}

# =====================================================================
# Choice type resolution (value[x] pattern)
# =====================================================================
query I
SELECT fhirpath_text('{"resourceType":"Observation","valueString":"normal"}', 'value');
----
normal

# =====================================================================
# v0.0.4 Regression: fhirpath_date rejects invalid month/day
# =====================================================================

# Invalid month (99) should return NULL
query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"2020-99-99"}', 'birthDate');
----
NULL

# Invalid day (32) should return NULL
query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"2020-01-32"}', 'birthDate');
----
NULL

# Invalid month (13) should return NULL
query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"2020-13-01"}', 'birthDate');
----
NULL

# Feb 29 on leap year is valid
query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"2024-02-29"}', 'birthDate');
----
2024-02-29

# Feb 29 on non-leap year should return NULL
query I
SELECT fhirpath_date('{"resourceType":"Patient","birthDate":"2023-02-29"}', 'birthDate');
----
NULL

# =====================================================================
# v0.0.4 Regression: fhirpath_number singleton enforcement
# =====================================================================

# Multi-item array should return NULL (not first element)
query I
SELECT fhirpath_number('{"resourceType":"Observation","a":[1,2]}', 'a');
----
NULL

# Single item array is fine
query I
SELECT fhirpath_number('{"resourceType":"Observation","a":[42]}', 'a');
----
42.0

# FP-06 regression: iif() must reject multi-item input before evaluating a branch
query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p"}', '(''a''|''b'').iif(true, ''yes'', ''no'')');
----
NULL

query I
SELECT fhirpath_is_valid('iif(true)');
----
false

query I
SELECT fhirpath_is_valid('iif(1|2, ''yes'', ''no'')');
----
false

query I
SELECT fhirpath_json('{"resourceType":"Patient","id":"p"}', 'iif(true, ''yes'', ''no'', ''extra'')');
----
NULL

query I
SELECT fhirpath_json('{"resourceType":"Patient","id":"p"}', 'iif(true, ''safe'', (1|2).toInteger())');
----
["safe"]

# FP-02 EXPLORER regression: implies may not short-circuit away RHS
# singleton Boolean validation. Multi-item RHS operands are errors even when
# the left operand is false.
query II
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p","arr":[1,2]}', 'false implies (1 | 2)'),
       fhirpath_is_valid('false implies (1 | 2)');
----
NULL	false

query II
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p","arr":[1,2]}', 'false implies arr'),
       fhirpath_is_valid('false implies arr');
----
NULL	true

query II
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p","arr":[1]}', 'false implies arr'),
       fhirpath_bool('{"resourceType":"Patient","id":"p","arr":[]}', 'false implies arr');
----
true	true

# FP-06 regression: convertsToBoolean()/convertsToInteger() take no arguments
query I
SELECT fhirpath_is_valid('''true''.convertsToBoolean(2)');
----
false

query I
SELECT fhirpath_json('{"resourceType":"Observation","strTrue":"true"}', '''true''.convertsToBoolean(2)');
----
NULL

query I
SELECT fhirpath_is_valid('''1''.convertsToInteger(2)');
----
false

query I
SELECT fhirpath_json('{"resourceType":"Observation","strInt":"1"}', 'convertsToInteger(strInt)');
----
NULL

query I
SELECT fhirpath_is_valid('convertsToInteger(strInt)');
----
false

query I
SELECT fhirpath_is_valid('true.toBoolean(1)');
----
false

query I
SELECT fhirpath_json('{"resourceType":"Patient","id":"p"}', '''1''.toInteger(2)');
----
NULL

query II
SELECT fhirpath_json('{"resourceType":"Patient","id":"p"}', '-2147483649.toInteger()'),
       fhirpath_is_valid('-2147483649.toInteger()');
----
NULL	false

query II
SELECT fhirpath_json('{"resourceType":"Patient","id":"p"}', '''\uD834'''),
       fhirpath_is_valid('''\uD834''');
----
NULL	false

# FP-02 regression: type operators bind tighter than union per FHIRPath precedence
query I
SELECT fhirpath_json('{"resourceType":"Patient","id":"p"}', '1 | 2 is Integer');
----
[1,true]

query I
SELECT fhirpath_json('{"resourceType":"Patient","id":"p"}', '1 | ''a'' as String');
----
[1,"a"]

query I
SELECT fhirpath_is_valid('1 | 2 is Integer');
----
true

# FP-02 regression: trim() must not silently take the first item of a multi-item input
query I
SELECT fhirpath_text('{"resourceType":"Patient","name":[{"given":[" Ann "," Bob "]}]}', 'name.given.trim()');
----
NULL

# FP-07 regression: decimal strings must match (+|-)?\d+(\.\d+)?
query I
SELECT fhirpath_text('{"resourceType":"Observation","v":"1e2"}', 'v.toDecimal()');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":"1e2"}', 'v.convertsToDecimal()');
----
false

query I
SELECT fhirpath_text('{"resourceType":"Observation","v":"1."}', 'v.toDecimal()');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":"1."}', 'v.convertsToDecimal()');
----
false

query I
SELECT fhirpath_text('{"resourceType":"Observation","v":" 1"}', 'v.toDecimal()');
----
NULL

# FP-07 regression: Date/DateTime conversion must not coerce non-string values
query I
SELECT fhirpath_text('{"resourceType":"Observation","v":2015}', 'v.toDate()');
----
NULL

query I
SELECT fhirpath_timestamp('{"resourceType":"Observation","v":2015}', 'v.toDateTime()');
----
NULL

# FP-07 regression: malformed DateTime-like strings must not be truncated to Date
query I
SELECT fhirpath_date('{"resourceType":"Observation","v":"2015-02-04T99"}', 'v.toDate()');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":"2015-02-04Tbogus"}', 'v.convertsToDate()');
----
false

# FP-07 regression: Date/DateTime converters accept one optional format argument
query I
SELECT fhirpath_date('{"resourceType":"Observation","v":"15-01-2024"}', 'v.toDate(''dd-MM-yyyy'')');
----
2024-01-15

query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":"15-01-2024"}', 'v.convertsToDate(''dd-MM-yyyy'')');
----
true

query I
SELECT fhirpath_timestamp('{"resourceType":"Observation","v":"15-01-2024 23:30:05.123"}', 'v.toDateTime(''dd-MM-yyyy HH:mm:ss.SSS'')');
----
2024-01-15T23:30:05.123

query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":"15-01-2024 23:30:05.123"}', 'v.convertsToDateTime(''dd-MM-yyyy HH:mm:ss.SSS'')');
----
true

query I
SELECT fhirpath_date('{"resourceType":"Patient","id":"p"}', '@2024-01-15.toDate(''bogus'')');
----
2024-01-15

query I
SELECT fhirpath_date('{"resourceType":"Observation","v":"15-01-2024","fmt":"dd-MM-yyyy"}', 'v.toDate(fmt)');
----
2024-01-15

query I
SELECT fhirpath_timestamp('{"resourceType":"Observation","v":"15/01/2024 23:30:05 -0500","fmt":"dd/MM/yyyy HH:mm:ss Z"}', 'v.toDateTime(fmt)');
----
2024-01-15T23:30:05-05:00

query I
SELECT fhirpath_timestamp('{"resourceType":"Patient","id":"p","fmt":"bogus"}', '@2024-01-15.toDateTime(fmt)');
----
2024-01-15T

# FP-07 regression: Decimal converters remain zero-argument functions
query I
SELECT fhirpath_is_valid('''1''.toDecimal(2)');
----
false

# FP-07 regression: Date values are not decimal-convertible
query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p"}', '@2015.toDecimal()');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p"}', '@2015.convertsToDecimal()');
----
false

# FP-07 regression: STU Long literals are decimal-convertible
query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p"}', '42L.toDecimal()');
----
42.0

query I
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p"}', '42L.convertsToDecimal()');
----
true

query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p"}', '9223372036854775807L.toDecimal()');
----
9223372036854775807.0

query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p"}', '(-9223372036854775808L).toDecimal()');
----
-9223372036854775808.0

query I
SELECT fhirpath_is_valid('9223372036854775808L.toDecimal()');
----
false

# FP-07 HISTORIAN regression: §5.5.6 examples require string Long values to be
# decimal-convertible while malformed string suffixes remain rejected.
query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p"}', '''42L''.toDecimal()');
----
42.0

query I
SELECT fhirpath_bool('{"resourceType":"Patient","id":"p"}', '''42L''.convertsToDecimal()');
----
true

query I
SELECT fhirpath_text('{"resourceType":"Patient","id":"p"}', '''1LL''.toDecimal()');
----
NULL

# FP-08 regression: Time conversion must preserve partial precision
query I
SELECT fhirpath_text('{"resourceType":"Observation","v":"14:34"}', 'v.toTime()');
----
14:34

query I
SELECT fhirpath_text('{"resourceType":"Observation","v":"x"}', '@T14:34.toString()');
----
14:34

# FP-08 regression: Quantity conversion string parsing and target units
query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":"1 wk"}', 'v.convertsToQuantity()');
----
false

query I
SELECT fhirpath_quantity('{"resourceType":"Observation","v":" 1"}', 'v.toQuantity()');
----
NULL

query I
SELECT fhirpath_quantity('{"resourceType":"Observation","v":"1 ''mg"}', 'v.toQuantity()');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":"1 ''''"}', 'v.convertsToQuantity()');
----
false

query I
SELECT fhirpath_quantity('{"resourceType":"Observation","v":"1 ''''"}', 'v.toQuantity()');
----
NULL

query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":1}', 'v.convertsToQuantity(''kg'')');
----
false

query I
SELECT fhirpath_bool('{"resourceType":"Observation","v":"1 ''kg''"}', 'v.convertsToQuantity(''g'')');
----
true

query I
SELECT fhirpath_quantity('{"resourceType":"Observation","v":"1 ''kg''"}', 'v.toQuantity(''g'')');
----
1000 'g'

query I
SELECT fhirpath_quantity('{"resourceType":"Observation","valueQuantity":{"value":5,"unit":"mg","system":"http://unitsofmeasure.org","code":"mg"},"targetUnit":"g"}', 'value.toQuantity(targetUnit)');
----
0.005 'g'

query I
SELECT fhirpath_bool('{"resourceType":"Observation","valueQuantity":{"value":5,"unit":"mg","system":"http://unitsofmeasure.org","code":"mg"},"targetUnit":"g"}', 'value.convertsToQuantity(targetUnit)');
----
true

query I
SELECT fhirpath('{"resourceType":"Observation","items":[{"quantityText":"1 ''kg''","targetUnit":"g"},{"quantityText":"1000 ''mg''","targetUnit":"g"}]}', 'items.select(quantityText.toQuantity(targetUnit))');
----
['1000 \'g\'', '1 \'g\'']

query I
SELECT fhirpath_text('{"resourceType":"Observation","v":"1 ''mg''"}', 'v.toQuantity(''kg'').toString()');
----
0.000001 'kg'

query I
SELECT fhirpath_text('{"resourceType":"Observation","v":"1000000000000000 ''g''"}', 'v.toQuantity().toString()');
----
1000000000000000 'g'

query I
SELECT fhirpath_text('{"resourceType":"Observation","smallDecimal":1e-6}', 'smallDecimal.toString()');
----
0.000001

query I
