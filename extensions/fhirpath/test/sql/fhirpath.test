# FP-02 EXPLORER regression: dot invocation binds before unary +/-.
# The normative §6.8 example parses -7.combine(3) as -(7.combine(3)),
# so unary operators must reject the multi-item operand.
query I
SELECT fhirpath_text('{"resourceType":"Patient"}', '-7.combine(3)');
----
NULL

query I
SELECT fhirpath_text('{"resourceType":"Patient"}', '+7.combine(3)');
