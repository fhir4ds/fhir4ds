{
  "id": "omop-person",
  "url": "https://example.org/omop/ViewDefinition/Patient",
  "description": "OMOP person table, sourced from OMOP identifiers on patient resources.",
  "resource": "Patient",
  "select": [
    {
      "column": [
        {
          "name": "person_id",
          "type": "string",
          "path": "identifier.where(system = 'urn:omop:person_id').value.first()"
        },
        {
          "name": "source_system",
          "type": "string",
          "path": "identifier.where(system = 'urn:omop:source_system').value.first()"
        }
      ]
    }
  ],
  "resourceType": "ViewDefinition",
  "status": "active",
  "name": "omop_person"
}
