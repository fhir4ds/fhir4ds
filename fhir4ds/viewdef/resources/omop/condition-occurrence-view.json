{
  "name": "omop_condition_occurrence",
  "status": "draft",
  "resource": "Condition",
  "constant": [
    {
      "name": "snomed_uri",
      "valueString": "http://snomed.info/sct"
    },
    {
      "name": "icd10cm_uri",
      "valueString": "http://hl7.org/fhir/sid/icd-10-cm"
    },
    {
      "name": "icd10_uri",
      "valueString": "http://hl7.org/fhir/sid/icd-10"
    },
    {
      "name": "ehr_type_concept",
      "valueString": "32810"
    }
  ],
  "select": [
    {
      "column": [
        {
          "name": "condition_occurrence_id",
          "path": "id",
          "type": "id"
        },
        {
          "name": "person_id",
          "path": "subject.reference.split('/').last()",
          "type": "string"
        },
        {
          "name": "condition_concept_id",
          "path": "cm.concept_id",
          "type": "string"
        },
        {
          "name": "condition_start_date",
          "path": "onset.ofType(dateTime).substring(0, 10)",
          "type": "date"
        },
        {
          "name": "condition_start_datetime",
          "path": "onset.ofType(dateTime)",
          "type": "dateTime"
        },
        {
          "name": "condition_end_date",
          "path": "abatement.ofType(dateTime).substring(0, 10)",
          "type": "date"
        },
        {
          "name": "condition_end_datetime",
          "path": "abatement.ofType(dateTime)",
          "type": "dateTime"
        },
        {
          "name": "condition_type_concept_id",
          "path": "cmtype.concept_id",
          "type": "string"
        },
        {
          "name": "condition_status_concept_id",
          "path": "clinicalStatus.coding.code.first()",
          "type": "code"
        },
        {
          "name": "condition_source_value",
          "path": "iif(code.coding.where(system=%snomed_uri).exists(), code.coding.where(system=%snomed_uri).code.first(), iif(code.coding.where(system=%icd10cm_uri).exists(), code.coding.where(system=%icd10cm_uri).code.first(), iif(code.coding.where(system=%icd10_uri).exists(), code.coding.where(system=%icd10_uri).code.first(), code.coding.code.first())))",
          "type": "code"
        },
        {
          "name": "visit_occurrence_id",
          "path": "encounter.reference.split('/').last()",
          "type": "string"
        }
      ]
    }
  ],
  "joins": [
    {
      "name": "cm",
      "view": "omop_conceptmap",
      "type": "left",
      "on": [
        {
          "path": "iif(code.coding.where(system=%snomed_uri).exists(), code.coding.where(system=%snomed_uri).code.first(), iif(code.coding.where(system=%icd10cm_uri).exists(), code.coding.where(system=%icd10cm_uri).code.first(), iif(code.coding.where(system=%icd10_uri).exists(), code.coding.where(system=%icd10_uri).code.first(), code.coding.code.first())))"
        },
        {
          "path": "cm.concept_code"
        },
        {
          "path": "iif(code.coding.where(system=%snomed_uri).exists(), %snomed_uri, iif(code.coding.where(system=%icd10cm_uri).exists(), %icd10cm_uri, iif(code.coding.where(system=%icd10_uri).exists(), %icd10_uri, code.coding.system.first())))"
        },
        {
          "path": "cm.source_system"
        }
      ]
    },
    {
      "name": "cmtype",
      "view": "omop_conceptmap",
      "type": "left",
      "on": [
        {
          "path": "category.coding.code.first()"
        },
        {
          "path": "cmtype.concept_code"
        },
        {
          "path": "category.coding.system.first()"
        },
        {
          "path": "cmtype.source_system"
        }
      ]
    }
  ]
}