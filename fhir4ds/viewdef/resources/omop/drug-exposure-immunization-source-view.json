{
  "name": "drug_exposure_immunization_source",
  "status": "draft",
  "resource": "Immunization",
  "constant": [
    {
      "name": "cvx_uri",
      "valueString": "http://hl7.org/fhir/sid/cvx"
    },
    {
      "name": "rx_administered",
      "valueString": "38000180"
    }
  ],
  "select": [
    {
      "column": [
        {
          "name": "drug_exposure_id",
          "path": "id",
          "type": "id"
        },
        {
          "name": "person_id",
          "path": "patient.reference.replace('urn:uuid:', '').split('/').last()",
          "type": "string"
        },
        {
          "name": "drug_exposure_start_date",
          "path": "occurrenceDateTime.substring(0, 10)",
          "type": "date"
        },
        {
          "name": "drug_exposure_start_datetime",
          "path": "occurrenceDateTime",
          "type": "dateTime"
        },
        {
          "name": "drug_exposure_end_date",
          "path": "occurrenceDateTime.substring(0, 10)",
          "type": "date"
        },
        {
          "name": "drug_exposure_end_datetime",
          "path": "occurrenceDateTime",
          "type": "dateTime"
        },
        {
          "name": "drug_type_concept_id",
          "path": "%rx_administered",
          "type": "string"
        },
        {
          "name": "sig",
          "path": "iif(dosage[0].text.exists(), dosage[0].text, null)",
          "type": "string"
        },
        {
          "name": "quantity_num",
          "path": "doseQuantity.value",
          "type": "decimal"
        },
        {
          "name": "days_supply",
          "path": "iif(0 = 1, 0, null)",
          "type": "integer"
        },
        {
          "name": "drug_source_value",
          "path": "vaccineCode.coding.code.first()",
          "type": "code"
        },
        {
          "name": "visit_occurrence_id",
          "path": "encounter.reference.replace('urn:uuid:', '').split('/').last()",
          "type": "string"
        },
        {
          "name": "src",
          "path": "'Immunization'",
          "type": "string"
        },
        {
          "name": "source_code",
          "path": "vaccineCode.coding.code.first()",
          "type": "string"
        },
        {
          "name": "source_system",
          "path": "vaccineCode.coding.system.first()",
          "type": "string"
        }
      ]
    }
  ]
}
