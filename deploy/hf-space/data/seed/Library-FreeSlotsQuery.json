      "extension": [
        {
          "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
          "valueString": "-- Free slots with their schedule context, newest windows first.\n-- Depends on the ViewDefinitions slot_view and schedule_view (by canonical).\nSELECT\n  s.slot_id,\n  s.starts_at,\n  s.ends_at,\n  sc.actor_display,\n  sc.service_type_display\nFROM slot_view AS s\nJOIN schedule_view AS sc\n  ON split_part(s.schedule, '/', 2) = sc.schedule_id\nWHERE s.status = $status\nORDER BY s.starts_at\nLIMIT 100\n"
        }
      ]
    }
  ]
